generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String    @default("")
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  videos       Video[]
}

// Lifecycle of the HLS rendition, independent of the upload lifecycle above it.
enum ProcessingStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum VideoStatus {
  UPLOADING
  VERIFYING
  UPLOADED
  FAILED
  CANCELED
}

model Video {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @db.Uuid
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  originalName          String
  mimeType              String
  sizeBytes             Int
  status                VideoStatus @default(UPLOADING)
  uploadKey             String      @unique
  objectKey             String?     @unique
  etag                  String?
  error                 String?
  uploadExpiresAt       DateTime
  verificationToken     String?     @db.Uuid
  verificationStartedAt DateTime?
  uploadedAt            DateTime?
  processingStatus      ProcessingStatus?
  processingProgress    Int               @default(0)
  processingError       String?
  processingToken       String?           @db.Uuid
  processingHeartbeatAt DateTime?
  mediaVersion          String?           @db.Uuid
  mediaPrefix           String?           @unique
  durationSeconds       Float?
  width                 Int?
  height                Int?
  videoCodec            String?
  audioCodec            String?
  renditions            Json?
  processedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, createdAt, id])
  @@index([status, uploadExpiresAt])
  @@index([processingStatus, processingHeartbeatAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
