# Local development only. Keep .env out of version control.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=4200
WEB_ORIGIN=http://localhost:4200

# npm run setup generates a unique secret in .env. Never use a shared default.
JWT_SECRET=
JWT_TTL_SECONDS=3600

POSTGRES_USER=efiemipeg
POSTGRES_PASSWORD=efiemipeg_local_password
POSTGRES_DB=efiemipeg
POSTGRES_PORT=5432
# URL-encode credentials here if changing the values above.
DATABASE_URL=postgresql://efiemipeg:efiemipeg_local_password@localhost:5432/efiemipeg?schema=public

REDIS_PORT=6379
REDIS_PASSWORD=efiemipeg_local_redis
REDIS_URL=redis://:efiemipeg_local_redis@localhost:6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=efiemipeg
MINIO_ROOT_PASSWORD=efiemipeg_local_storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=efiemipeg
S3_SECRET_ACCESS_KEY=efiemipeg_local_storage
S3_BUCKET=videos

# Upload limits: 1 GiB per original; single PUT URLs last one hour.
MAX_VIDEO_BYTES=1073741824
UPLOAD_URL_TTL_SECONDS=3600
# Optional browser-reachable storage address if different from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
