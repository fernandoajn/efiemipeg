{
  "name": "efiemipeg",
  "version": "0.1.0",
  "private": true,
  "description": "A personal video streaming platform with private user accounts",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "nx": {
      "undici": "^7.30.1"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "nx run-many -t serve --projects=api,web --parallel=2",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run api:test",
    "check": "npm run typecheck && npm test && npm run build",
    "infra:up": "docker compose up -d --wait && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/auth-smoke.mjs",
    "smoke:stream": "node scripts/stream-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@smithy/node-http-handler": "^4.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "hls.js": "^1.7.4",
    "ioredis": "^5.8.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "nx": "^24.0.2",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
